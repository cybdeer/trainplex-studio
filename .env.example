# TrainPlex Studio — environment variable template.
#
# Copy this file to .env and fill in real values for your environment.
# .env is git-ignored (see .gitignore). Never commit secrets.

# Django / Label Studio core
DJANGO_DB=sqlite
LOG_LEVEL=INFO
LABEL_STUDIO_HOST=http://studio.trainplex.in
INCLUDE_DEV=false

# TrainPlex branding + ops
TRAINPLEX_BRAND=true
TRAINPLEX_FOUNDER_EMAIL=ops@trainplex.in
TRAINPLEX_DAILY_REPORT_HOUR_IST=8

# Founder personal mobile (NEVER in outbound, used for detection guard only).
# Leave empty in dev / CI. In production set to the founder's personal
# mobile (digits only, with or without ``91`` country code) — the value is
# read by ``core.services.founder_guard`` and used to scrub the digits
# from any outbound text. Setting this in this template file is forbidden.
TRAINPLEX_FOUNDER_MOBILE_GUARD=

# Wave-19 W2-MOCK-REAL dry-run guards. Keep all three at ``true`` until
# the matching live creds are populated below and end-to-end verified —
# every flag flipping to ``false`` triggers a real outbound call.
TRAINPLEX_WA_DRY_RUN=true
TRAINPLEX_RAZORPAY_DRY_RUN=true
TRAINPLEX_BULK_ASSIGN_DRY_RUN=true

# AiSensy WhatsApp creds (Wave-19 W2-MOCK-REAL).
AISENSY_API_KEY=
AISENSY_API_URL=https://backend.aisensy.com/campaign/t1/api/v2

# Razorpay X payout + webhook (Wave-19 W2-MOCK-REAL).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_X_ACCOUNT_NUMBER=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_BASE_URL=https://api.razorpay.com/v1
